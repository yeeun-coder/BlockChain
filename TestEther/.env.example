# 이 파일을 .env 로 복사한 뒤 값을 직접 입력하세요. (.env는 Git에 올리지 않습니다)

# 지급 지갑 개인키: 0x 로 시작하는 64자리 16진수
# MetaMask에서 내보낸 키에 0x가 없으면 앞에 붙여 주세요.
PRIVATE_KEY=

# Sepolia RPC URL (Infura, Alchemy 등). API 키가 들어 있으면 비밀값입니다.
SEPOLIA_RPC_URL=

# 학번 목록 (주로 Vercel 배포용, 한 줄에 학번 하나)
# 로컬에서는 이 줄을 주석으로 두면 StudentID.csv 파일을 읽습니다.
# 주석을 풀고 값을 비워 두면 "학번 목록 미설정"이 됩니다.
# STUDENT_IDS_CSV=
